% =============================================================================
%  references.bib  --  BibTeX database.
%  Replace these placeholder entries with your own references.
%  The citation style is Harvard (author--year) via aeaown.bst (natbib).
%  Usage in text:  \citep{key}  \citet{key}  \citep[e.g.,][]{key1,key2}
%  请将下列示例条目替换为你自己的参考文献。
% =============================================================================

% ---- Article in a journal (期刊论文) ----
@article{author2020example,
  author  = {Author, Alice and Author, Bob},
  title   = {The Title of a Journal Article},
  journal = {Journal Name},
  volume  = {64},
  number  = {3},
  pages   = {100--120},
  year    = {2020},
  publisher = {Publisher Name}
}

% ---- Book (专著) ----
@book{author2018book,
  author    = {Author, Carol},
  title     = {The Title of a Book},
  publisher = {Publisher Name},
  address   = {City},
  year      = {2018}
}

% ---- Chapter in an edited volume (编著章节) ----
@incollection{author2019chapter,
  author    = {Author, Dave},
  title     = {The Title of a Chapter},
  editor    = {Editor, Eve},
  booktitle = {The Title of the Edited Volume},
  publisher = {Publisher Name},
  pages     = {45--67},
  year      = {2019}
}

% ---- Working paper / unpublished manuscript (工作论文) ----
@unpublished{author2024working,
  author = {Author, Frank},
  title  = {The Title of a Working Paper},
  note   = {Working paper, Department, University},
  year   = {2024}
}

% ---- Online source (在线资源) ----
@misc{dataset2024example,
  author       = {{Data Provider Name}},
  title        = {Title of the Dataset or Online Resource},
  howpublished = {\url{https://example.org/data}},
  year         = {2024},
  note         = {Accessed: 2024-01-01}
}

% ---- Chinese-language reference (中文文献示例) ----
% Note: with XeLaTeX + xeCJK the Chinese characters in author/title fields
% are typeset correctly as long as the .bib file is saved in UTF-8.
@book{zhang2018example,
  author    = {张伟},
  title     = {研究方法导论},
  publisher = {出版社名称},
  address   = {北京},
  year      = {2018}
}
